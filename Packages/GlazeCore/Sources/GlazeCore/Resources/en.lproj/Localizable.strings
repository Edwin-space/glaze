"help.accessibility_format" = "About %@";
"help.subtitle.language" = "The spoken language as the video file records it. When the file says, Glaze uses that to write subtitles; when it does not, Glaze listens and works it out. Taking the file at its word is both more accurate and considerably faster.";
"help.subtitle.model_tier" = "The AI model that turns speech into text. Faster tiers finish sooner; more accurate tiers catch mumbled lines and names that the others miss. An accurate model downloads a larger file once and takes longer to run. If the subtitles read badly, move up a tier.";
"help.subtitle.storage" = "Where finished subtitle files are kept. Next to the video means other devices and other players can find them, and for a video on a NAS it means the subtitle lands on the NAS too. If that folder cannot be written to, Glaze keeps it inside the app instead.";
"help.subtitle.files" = "The subtitles available for this video — both the ones inside the video file and any sitting beside it. Only text subtitles can be used; picture-based ones cannot be read yet.";
"help.subtitle.generate" = "Listens to the video and writes subtitles from scratch. Use this when there are no usable subtitles at all.";
"help.subtitle.translate_engine" = "The engine doing the translating. Right now that is the translator built into macOS, which runs on this Mac rather than sending your subtitles anywhere.";
"help.subtitle.translate_quality" = "Fast favours speed; high fidelity favours accuracy. Subtitles are made once and watched many times, so high fidelity is usually the better trade.";
"help.subtitle.translate_output" = "Whether to show only the translation, or the original line with the translation beneath it. The pair is useful if you are learning the language.";
"help.media.container" = "The file format — MP4, MKV and so on — that bundles picture, sound, and subtitles together. It says nothing about quality.";
"help.media.playback" = "Whether macOS can play this file as-is. When it cannot, Glaze switches to its own playback engine for you.";
"help.media.tracks" = "The separate streams inside the file: picture, sound, and subtitles. A dubbed film may carry several sound tracks.";
"help.assistant.metadata" = "What Glaze worked out about the film or series from the file name. Once confirmed, it can show the poster and synopsis.";
"help.assistant.source" = "Where this video came from — a folder on your Mac, or a NAS on your network.";
"help.network.browser" = "Finds and plays videos from a NAS or media server on your network. The NAS needs its DLNA (or UPnP) media server switched on before it will appear.";
"help.subtitle.current" = "What subtitles are ready for this video right now. This is a status, not a setting.";
